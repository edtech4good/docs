# Production environment for the self-hosted stack.
#
#   cp .env.production.example .env.production   # then fill every REQUIRED value
#
# Both APIs read this one file (compose `env_file`). Never commit .env.production:
# it holds real secrets. Both APIs FAIL CLOSED on the committed placeholder
# secrets when NODE_ENV != development, so a missing REQUIRED value below stops
# the container at boot rather than running insecure.
#
# Generate secrets with:  openssl rand -hex 32
#
# Compose's env-file parser only treats `#` as a comment start after a
# non-empty value, so an empty REQUIRED value must carry no trailing comment.

# ─── Domains (also used by the Caddyfile) ────────────────────────────────────
# Point A records for all four at the host before `up`.
ADMIN_DOMAIN=admin.example.org           # Angular admin UI
API_DOMAIN=api.example.org               # central LMS API
STUDENT_API_DOMAIN=student-api.example.org  # student API (Expo app + central proxy target)
APP_DOMAIN=app.example.org               # Expo web app

# ─── Database ────────────────────────────────────────────────────────────────
# Central and student APIs use SEPARATE databases on the same server.
# Managed MySQL: use its connection details. On-host (--profile with-db):
# DB_HOST=mysql, RPI_DB_HOST=mysql, DB_USER=edtech_local, RPI_DB_USER=edtech_local,
# and both *_PASSWORD values set to the generated password you put in
# docker/mysql-init/01-databases.sql in place of edtech_dev_pass (see the guide).
DB_HOST=your-managed-db-host
DB_PORT=3306
DB_NAME=edtech_lms
DB_USER=your-db-user
# REQUIRED
DB_PASSWORD=
RPI_DB_HOST=your-managed-db-host          # same server as DB_HOST
RPI_DB_PORT=3306
RPI_DB_NAME=edtech_lms_rpi
RPI_DB_USER=your-db-user
# REQUIRED (same server, may be same creds)
RPI_DB_PASSWORD=
# only for the on-host `with-db` profile
MYSQL_ROOT_PASSWORD=

# ─── Secrets: central API ────────────────────────────────────────────────────
# REQUIRED: JWT signing (openssl rand -hex 32)
APPLICATION_SECRET=
# REQUIRED
APPLICATION_API_KEY=
# REQUIRED: used to reach the student API
RPI_SECRET=

# ─── Secrets: student API ────────────────────────────────────────────────────
# REQUIRED: student API JWT signing
RPI_APPLICATION_SECRET=

# ─── Cross-API coordination (get these WRONG and reports 500 / logins fail) ──
# SERVER_SYNC_KEY authenticates the central→student proxy. It must be the SAME
# value both sides see; the student API accepts SERVER_SYNC_KEY (or
# RPI_SERVER_SYNC_KEY), so setting it once here covers both.
# REQUIRED: identical for both APIs
SERVER_SYNC_KEY=
# Where the central API proxies /report/online/* and CSV downloads. Unset -> the
# Online reports 500. Must be the student API's public URL.
RPI_CLOUD=https://student-api.example.org

# ─── CORS / browser origins ──────────────────────────────────────────────────
# Central API allows the admin UI origin; student API allows the Expo web origin.
# Both read CORS_ORIGINS (comma-separated); UI_URL is an extra central allow.
UI_URL=https://admin.example.org
CORS_ORIGINS=https://admin.example.org,https://app.example.org

# ─── S3 / object storage (admin document and feedback uploads) ───────────────
# REQUIRED for admin document and feedback uploads
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
# e.g. an S3-compatible endpoint, if not AWS itself
AWS_ENDPOINT=

# ─── SMTP (optional: staff self-service password reset only) ─────────────────
# Leave blank to accept admin-mediated resets instead. Learners never use email.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true

# NOT set here: these are BAKED IN AT BUILD TIME, not runtime:
#   • Angular admin UI  -> edtech-lms-ui/src/environments/environment.prod.ts
#                          (API_URL = api.example.org, SCHEMA = https, s3Link)
#   • Expo web          -> EXPO_PUBLIC_BASE_URL / EXPO_PUBLIC_RESOURCE_URL /
#                          EXPO_PUBLIC_RESOURCE_PATH, passed as compose build
#                          args (see docker-compose.prod.yml)
EXPO_PUBLIC_BASE_URL=https://student-api.example.org
EXPO_PUBLIC_RESOURCE_URL=https://your-s3-or-spaces-base
# Path segment joined between EXPO_PUBLIC_RESOURCE_URL and each media filename:
# a bucket folder, or `media` to use this kit's local /media route instead of
# a bucket (see the guide, "Media").
EXPO_PUBLIC_RESOURCE_PATH=media

# Rate limiter keys on client IP. Set to 1 only when the API sits behind Caddy (this stack);
# leave unset on a Pi or a bare host, or clients can spoof X-Forwarded-For to dodge the limit.
TRUST_PROXY=1
